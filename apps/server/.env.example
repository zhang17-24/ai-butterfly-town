# ============================================================
# AI 蝴蝶小镇 环境变量样例(docker compose 插值 / Render 面板对照)
# 复制为 .env 填入真实密钥。密钥不要提交仓库。
# 本地开发见 apps/server/.env.example(server 读取同套变量)。
# ============================================================

# ---- 服务 ----
PORT=3100
WEB_ORIGIN=
DATABASE_PATH=./data/ai-town.db
COOKIE_SECRET=please-change-me-to-a-long-random-string
DEMO_USERNAME=demo
DEMO_PASSWORD=town1234
SIMULATION_TICK_MS=2000
# 容器部署设为 1,由 server 托管 Web 静态文件(单容器方案)
SERVE_WEB=1

# ---- DeepSeek(主对话模型:NPC 决策 + 玩家对话) ----
AI_SIMULATION_API_KEY=
AI_SIMULATION_BASE_URL=https://api.deepseek.com/v1
AI_SIMULATION_MODEL=deepseek-chat
AI_SIMULATION_API_STYLE=chat
AI_SIMULATION_CHAT_PATH=/chat/completions
AI_SIMULATION_TIMEOUT_MS=30000
AI_SIMULATION_MAX_OUTPUT_TOKENS=180
AI_SIMULATION_MAX_CONCURRENCY=2
AI_SIMULATION_MAX_DECISIONS_PER_TICK=99

# ---- 豆包 Seedream 生图(地图 + NPC 精灵表) ----
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
AI_IMAGE_MODEL=doubao-seedream-5-0-260128
AI_IMAGE_TIMEOUT_MS=120000

# ---- 豆包视觉审查(可选;无视觉授权留空自动回退像素统计审查) ----
AI_VISION_API_KEY=
AI_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
AI_VISION_MODEL=
AI_VISION_TIMEOUT_MS=120000
