{
  "name": "ai-butterfly-town",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @ai-town/server --filter @ai-town/web dev",
    "dev:server": "pnpm --filter @ai-town/server dev",
    "dev:web": "pnpm --filter @ai-town/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm typecheck && pnpm test && pnpm build",
    "delivery:check": "node scripts/delivery-check.mjs",
    "start": "pnpm --filter @ai-town/server start",
    "generate:sprites": "tsx apps/server/scripts/generate-npc-sprites.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
