#   AI_SIMULATION_API_KEY=sk-xxx
#   AI_SIMULATION_BASE_URL=https://api.deepseek.com/v1
#   AI_SIMULATION_MODEL=deepseek-chat
#   AI_SIMULATION_API_STYLE=chat
